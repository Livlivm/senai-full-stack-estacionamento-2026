generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "mysql"
}

model Automovel {
  placa        String    @id
  proprietario String
  tipo         String
  modelo       String
  marca        String?
  cor          String?
  ano          Int?
  telefone     String?
  Estadia      Estadia[]
}

model Estadia {
  id         Int       @id @default(autoincrement())
  placa      String
  entrada    DateTime  @default(now())
  saida      DateTime?
  valorHora  Float
  valorTotal Float?
  Automovel  Automovel @relation(fields: [placa], references: [placa])
}
